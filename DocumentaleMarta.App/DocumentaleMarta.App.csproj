<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DocumentaleMarta.Core\DocumentaleMarta.Core.csproj" />
    <ProjectReference Include="..\DocumentaleMarta.Data\DocumentaleMarta.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Icona dell'eseguibile (incudine e martello), generata da tools\genera-icona.ps1 -->
    <ApplicationIcon>Risorse\Documentale.ico</ApplicationIcon>

    <!-- Dati che Windows mostra nelle proprietà del file e che la finestra "Informazioni" legge -->
    <Product>Documentale</Product>
    <Company>METAL PROJET di Tedde Paolo e Sorrentino Luca snc</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Anche dentro l'eseguibile, per l'icona delle finestre -->
    <Resource Include="Risorse\Documentale.ico" />
  </ItemGroup>

</Project>
