<UserControl x:Class="DocumentaleMarta.App.Viste.CartellaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocumentaleMarta.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CartellaFormViewModel}"
             d:DesignWidth="760" d:DesignHeight="560"
             AllowDrop="True" DragEnter="Cartella_DragOver" DragOver="Cartella_DragOver"
             DragLeave="Cartella_DragLeave" Drop="Cartella_Drop">
    <UserControl.Resources>
        <ResourceDictionary>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="FontIcone">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Pulsanti compatti: icona e, al passaggio del mouse, la descrizione (come nelle griglie di radice e aree) -->
        <Style x:Key="PulsanteIcona" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="{StaticResource FontIcone}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Quanto manca alla scadenza, nel colore dell'urgenza -->
        <Style x:Key="TestoScadenza" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TestoTenue}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatoScadenza}" Value="Arancione">
                    <Setter Property="Foreground" Value="{DynamicResource TestoArancione}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatoScadenza}" Value="Rosso">
                    <Setter Property="Foreground" Value="{DynamicResource TestoRosso}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Etichetta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TestoSecondario}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Testo d'errore: sparisce quando è vuoto -->
        <Style x:Key="TestoErrore" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TestoRosso}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Errore}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RigaDocumento" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="{DynamicResource SfondoSuperficie}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FileMancante}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TestoRosso}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CellaTesto" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Intestazione, con i pulsanti dell'archivio completati -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Ripristina nell'area" Command="{Binding RipristinaCommand}"
                    Padding="12,3" Margin="12,0,0,0" ToolTip="Rimette la cartella nella sua area dell'albero"
                    Visibility="{Binding PuoRipristinare, Converter={StaticResource BoolToVis}}"/>
            <Button DockPanel.Dock="Right" Content="Archivia" Command="{Binding ArchiviaCommand}"
                    Padding="12,3" Margin="12,0,0,0"
                    ToolTip="Mette la cartella completata in «Archivio completati»: non sposta nessun file"
                    Visibility="{Binding PuoArchiviare, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource TestoTenue}" FontSize="13">
                    <Run Text="Cartella in "/><Run Text="{Binding NomeArea, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="·  archiviata in «Archivio completati»" Foreground="{DynamicResource IconaCompletata}" FontSize="13" Margin="8,0,0,0"
                           Visibility="{Binding Archiviata, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DockPanel>

        <!-- Campi: si salvano da soli -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Titolo" Style="{StaticResource Etichetta}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Titolo, UpdateSourceTrigger=LostFocus}"
                     MaxLength="200" FontSize="18" FontWeight="SemiBold" Padding="4,3"/>

            <TextBlock Grid.Row="1" Text="Descrizione" Style="{StaticResource Etichetta}"
                       VerticalAlignment="Top" Margin="0,14,12,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                     Text="{Binding Descrizione, UpdateSourceTrigger=LostFocus}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="6"
                     VerticalScrollBarVisibility="Auto" MaxLength="4000" Padding="4,3"/>

            <TextBlock Grid.Row="2" Text="Scadenza" Style="{StaticResource Etichetta}" Margin="0,10,12,0"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <DatePicker SelectedDate="{Binding DataScadenza}" Width="150"/>
                <Button Content="✕" Command="{Binding CancellaScadenzaCommand}" Margin="6,0,0,0" Width="26" Padding="0"
                        ToolTip="Rimuovi la scadenza"/>
                <TextBlock Text="{Binding TestoScadenza}" Style="{StaticResource TestoScadenza}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Si ripete" Style="{StaticResource Etichetta}" Margin="0,10,12,0"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox ItemsSource="{Binding OpzioniRicorrenza}" DisplayMemberPath="Testo" SelectedValuePath="Valore"
                          SelectedValue="{Binding Ricorrenza}" IsEnabled="{Binding HaScadenza}" Width="150"
                          ToolTip="Serve una scadenza: quando completi la cartella ti propone la successiva"/>
                <TextBlock Style="{StaticResource TestoScadenza}" Foreground="{DynamicResource TestoTenue}"
                           Text="Completandola ti propone la cartella successiva."
                           Visibility="{Binding SiRipete, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Completato" Style="{StaticResource Etichetta}" Margin="0,10,12,0"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox IsChecked="{Binding Completato}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TextBlock Text="Data completamento" Style="{StaticResource Etichetta}"/>
                <DatePicker SelectedDate="{Binding DataCompletamento}" IsEnabled="{Binding Completato}" Width="150"/>
            </StackPanel>

            <!-- Le note di completamento si vedono solo con «Completato» spuntato. L'etichetta sta sopra il campo (non nella
                 colonna delle etichette, che si allargherebbe e farebbe saltare il form). -->
            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,12,0,0"
                        Visibility="{Binding Completato, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Note di completamento" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NoteCompletamento, UpdateSourceTrigger=LostFocus}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="6"
                         VerticalScrollBarVisibility="Auto" MaxLength="4000" Padding="4,3"
                         AutomationProperties.Name="Note di completamento"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,8,0,0">
                <TextBlock Text="{Binding Errore}" Style="{StaticResource TestoErrore}"/>
                <TextBlock Text="Le modifiche vengono salvate automaticamente." Foreground="{DynamicResource TestoTenue}" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Barra dei documenti -->
        <DockPanel Grid.Row="2" Margin="0,18,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Copia in corso…" Foreground="{DynamicResource TestoSecondario}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding AllegaCommand.IsRunning, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Allega…" Command="{Binding AllegaCommand}" Padding="14,4"/>
                <Button Content="Apri in Esplora file" Command="{Binding ApriCartellaCommand}" Padding="12,4" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding TitoloDocumenti}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Griglia dei documenti -->
        <Grid Grid.Row="3">
            <DataGrid x:Name="Griglia" ItemsSource="{Binding Documenti}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BordoLeggero}" BorderBrush="{DynamicResource Bordo}" Background="{DynamicResource SfondoSuperficie}"
                      SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" RowHeight="36"
                      SelectedItem="{Binding DocumentoSelezionato, Mode=TwoWay}"
                      RowStyle="{StaticResource RigaDocumento}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TestoRosso}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ToolTip="Il file non si trova più nell'archivio"
                                           Visibility="{Binding FileMancante, Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nome file" Binding="{Binding NomeFile}" Width="*" MinWidth="120"
                                        ElementStyle="{StaticResource CellaTesto}"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="55"
                                        ElementStyle="{StaticResource CellaTesto}"/>
                    <DataGridTextColumn Header="Dimensione" Binding="{Binding DimensioneTesto}" Width="100"
                                        ElementStyle="{StaticResource CellaTesto}"/>
                    <DataGridTextColumn Header="Caricato il" Binding="{Binding DataCaricamento, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"
                                        ElementStyle="{StaticResource CellaTesto}"/>
                    <DataGridTemplateColumn Header="Azioni" Width="Auto" MinWidth="110" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="&#xE8E5;" Command="{Binding ApriCommand}" Style="{StaticResource PulsanteIcona}"
                                            ToolTip="Apri documento" AutomationProperties.Name="Apri documento"/>
                                    <Button Content="&#xE838;" Command="{Binding ApriNellaCartellaCommand}" Style="{StaticResource PulsanteIcona}"
                                            ToolTip="Apri nella cartella" AutomationProperties.Name="Apri nella cartella"/>
                                    <Button Content="&#xE74D;" Command="{Binding EliminaCommand}" Style="{StaticResource PulsanteIcona}"
                                            ToolTip="Elimina" AutomationProperties.Name="Elimina"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Elenco vuoto -->
            <TextBlock Text="Nessun documento. Usa «Allega…» per aggiungerne." Foreground="{DynamicResource TestoTenue}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Documenti.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Appare mentre si trascinano dei file sopra il form -->
        <Border x:Name="SuggerimentoRilascio" Grid.RowSpan="4" Margin="-12,-8" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource SfondoAccentoLeggero}" BorderBrush="{DynamicResource BordoAccento}" BorderThickness="2" CornerRadius="6" Opacity="0.94">
            <TextBlock Text="Rilascia qui i file per allegarli a questa cartella" FontSize="20" Foreground="{DynamicResource TestoAccento}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
