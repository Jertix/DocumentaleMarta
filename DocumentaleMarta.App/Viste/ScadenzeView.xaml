<UserControl x:Class="DocumentaleMarta.App.Viste.ScadenzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocumentaleMarta.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScadenzeViewModel}"
             d:DesignWidth="780" d:DesignHeight="360">
    <UserControl.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="FontIcone">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Sfondo della riga secondo l'urgenza della scadenza -->
            <Style x:Key="RigaScadenza" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="Background" Value="{DynamicResource SfondoSuperficie}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Avviso}" Value="Arancione">
                        <Setter Property="Background" Value="{DynamicResource SfondoArancione}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Avviso}" Value="Rosso">
                        <Setter Property="Background" Value="{DynamicResource SfondoRosso}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CellaTesto" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- Il "quando" (es. "Scade tra 5 giorni") nel colore dell'urgenza -->
            <Style x:Key="CellaQuando" TargetType="TextBlock" BasedOn="{StaticResource CellaTesto}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Avviso}" Value="Arancione">
                        <Setter Property="Foreground" Value="{DynamicResource TestoArancione}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Avviso}" Value="Rosso">
                        <Setter Property="Foreground" Value="{DynamicResource TestoRosso}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="IconaAvviso" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontIcone}"/>
                <Setter Property="Text" Value="&#xE7BA;"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource IconaArancione}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Avviso}" Value="Rosso">
                        <Setter Property="Foreground" Value="{DynamicResource IconaRossa}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <DataGrid x:Name="Griglia" ItemsSource="{Binding Righe}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BordoLeggero}" BorderBrush="{DynamicResource Bordo}" Background="{DynamicResource SfondoSuperficie}"
                  SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" RowHeight="36"
                  RowStyle="{StaticResource RigaScadenza}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="30" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource IconaAvviso}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Cartella" Binding="{Binding Titolo}" Width="*" MinWidth="140"
                                    ElementStyle="{StaticResource CellaTesto}"/>
                <DataGridTextColumn Header="Area" Binding="{Binding NomeArea}" Width="130" MinWidth="80"
                                    ElementStyle="{StaticResource CellaTesto}"/>
                <DataGridTextColumn Header="Scadenza" Binding="{Binding DataScadenza, StringFormat='dd/MM/yyyy'}" Width="90"
                                    ElementStyle="{StaticResource CellaTesto}"/>
                <DataGridTextColumn Header="Quando" Binding="{Binding Quando}" SortMemberPath="DataScadenza" Width="140"
                                    ElementStyle="{StaticResource CellaQuando}"/>
                <DataGridTextColumn Header="Documenti" Binding="{Binding NumeroDocumenti}" Width="100"
                                    ElementStyle="{StaticResource CellaTesto}"/>
                <DataGridTemplateColumn Header="Azioni" Width="Auto" MinWidth="130" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Vai alla cartella" Command="{Binding VaiAllaCartellaCommand}"
                                    Padding="10,2" Margin="2,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Nessuna scadenza -->
        <TextBlock Text="{Binding TestoVuoto}" Foreground="{DynamicResource TestoTenue}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Righe.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
