<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Gli stili comuni ai personaggi della striscia animata: sagome in un solo colore, quello dell'accento del tema
        (cambia con chiaro/scuro e con il colore principale).
    -->

    <!-- Parti piene: corpo, testa, orecchie, ali… -->
    <Style TargetType="Path">
        <Setter Property="Fill" Value="{DynamicResource TestoAccento}"/>
    </Style>
    <Style TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource TestoAccento}"/>
    </Style>

    <!-- Parti sottili disegnate con un tratto: braccia, gambe, code. Il tratto ha le punte arrotondate -->
    <Style x:Key="Tratto" TargetType="Path">
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Stroke" Value="{DynamicResource TestoAccento}"/>
        <Setter Property="StrokeThickness" Value="3"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
</ResourceDictionary>
