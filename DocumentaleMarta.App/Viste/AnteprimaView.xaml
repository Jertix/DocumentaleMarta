<UserControl x:Class="DocumentaleMarta.App.Viste.AnteprimaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocumentaleMarta.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AnteprimaViewModel}"
             d:DesignWidth="320" d:DesignHeight="520">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="FontIcone">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="TestoCentrale" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TestoTenue}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16,0"/>
        </Style>

        <!-- Le prime righe di un file di testo: sola lettura (si può selezionare e copiare); le righe vanno a capo, tranne che in CSV e XML -->
        <Style x:Key="TestoDocumento" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource SfondoSuperficie}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Bordo}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TestoACapo}" Value="True">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SfondoPannello}" BorderBrush="{DynamicResource Bordo}" BorderThickness="1,0,0,0">
        <DockPanel Margin="12,12,12,10">
            <DockPanel DockPanel.Dock="Top">
                <!-- Il doppio clic sull'immagine fa lo stesso; il pulsante serve a chi non lo sa -->
                <Button DockPanel.Dock="Right" Command="{Binding IngrandisciCommand}" Content="&#xE740;"
                        FontFamily="{StaticResource FontIcone}" Width="28" Height="24" Padding="0"
                        ToolTip="Ingrandisci (o fai doppio clic sull'anteprima)" AutomationProperties.Name="Ingrandisci l'anteprima"
                        Visibility="{Binding HaContenuto, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Anteprima" Foreground="{DynamicResource TestoTenue}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Titolo}" ToolTip="{Binding Titolo}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>

            <!-- Sfoglia le pagine (PDF e TIFF a più pagine) -->
            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="{Binding HaPagine, Converter={StaticResource BoolToVis}}">
                <Button Command="{Binding PaginaPrecedenteCommand}" Content="&#xE76B;" FontFamily="{StaticResource FontIcone}"
                        HorizontalAlignment="Left" Width="34" Height="28" Padding="0" ToolTip="Pagina precedente"
                        AutomationProperties.Name="Pagina precedente"/>
                <TextBlock Text="{Binding TestoPagina}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TestoSecondario}"/>
                <Button Command="{Binding PaginaSuccessivaCommand}" Content="&#xE76C;" FontFamily="{StaticResource FontIcone}"
                        HorizontalAlignment="Right" Width="34" Height="28" Padding="0" ToolTip="Pagina successiva"
                        AutomationProperties.Name="Pagina successiva"/>
            </Grid>

            <!-- Una precisazione sotto l'immagine, per esempio che è solo una miniatura -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Nota}" Foreground="{DynamicResource TestoTenue}" FontSize="11" TextWrapping="Wrap"
                       Margin="0,6,0,0" Visibility="{Binding HaNota, Converter={StaticResource BoolToVis}}"/>

            <Grid>
                <Border Background="White" BorderBrush="{DynamicResource Bordo}" BorderThickness="1" Cursor="Hand"
                        MouseLeftButtonDown="Immagine_MouseLeftButtonDown"
                        ToolTip="Doppio clic per ingrandire"
                        Visibility="{Binding HaImmagine, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding Immagine}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- File di testo: le prime righe, al posto dell'immagine (il pulsante in alto le apre in una finestra più grande) -->
                <TextBox Text="{Binding Testo, Mode=OneWay}" Style="{StaticResource TestoDocumento}"
                         AutomationProperties.Name="Prime righe del file di testo"
                         Visibility="{Binding HaTesto, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="Caricamento…" Style="{StaticResource TestoCentrale}"
                           Visibility="{Binding CaricamentoVisibile, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Messaggio}" Style="{StaticResource TestoCentrale}"
                           Visibility="{Binding HaMessaggio, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
