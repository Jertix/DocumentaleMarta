<Window x:Class="DocumentaleMarta.App.Viste.AnteprimaIngranditaDialog"
        Background="{DynamicResource SfondoFinestra}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocumentaleMarta.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AnteprimaViewModel}"
        Title="Anteprima ingrandita" Width="1000" Height="760" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/DocumentaleMarta.App;component/Risorse/Documentale.ico"
        PreviewKeyDown="Finestra_PreviewKeyDown" PreviewMouseWheel="Finestra_PreviewMouseWheel">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="FontIcone">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="PulsanteBarra" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="PulsanteIcona" TargetType="Button" BasedOn="{StaticResource PulsanteBarra}">
            <Setter Property="FontFamily" Value="{StaticResource FontIcone}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="TestoCentrale" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TestoTenue}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="520"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Barra: pagine a sinistra, zoom al centro, nota a destra -->
        <Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource SfondoPannello}" BorderBrush="{DynamicResource Bordo}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            Visibility="{Binding HaPagine, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding PaginaPrecedenteCommand}" Content="&#xE76B;" Style="{StaticResource PulsanteIcona}"
                            ToolTip="Pagina precedente" AutomationProperties.Name="Pagina precedente"/>
                    <TextBlock Text="{Binding TestoPagina}" VerticalAlignment="Center" Margin="6,0,10,0" MinWidth="86" TextAlignment="Center"/>
                    <Button Command="{Binding PaginaSuccessivaCommand}" Content="&#xE76C;" Style="{StaticResource PulsanteIcona}"
                            ToolTip="Pagina successiva" AutomationProperties.Name="Pagina successiva"/>
                    <Border Width="1" Background="{DynamicResource Bordo}" Margin="10,2,14,2"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="PulsanteMeno" Content="&#x2212;" Style="{StaticResource PulsanteBarra}" Click="Meno_Click"
                            ToolTip="Rimpicciolisci (−)" AutomationProperties.Name="Rimpicciolisci"/>
                    <TextBlock x:Name="TestoZoom" Text="Pagina intera" VerticalAlignment="Center" Margin="6,0" MinWidth="82" TextAlignment="Center"/>
                    <Button x:Name="PulsantePiu" Content="+" Style="{StaticResource PulsanteBarra}" Click="Piu_Click"
                            ToolTip="Ingrandisci (+)" AutomationProperties.Name="Ingrandisci"/>
                    <Button x:Name="PulsanteIntera" Content="Pagina intera" Style="{StaticResource PulsanteBarra}" Click="PaginaIntera_Click"
                            Margin="8,0,0,0" ToolTip="Mostra tutta la pagina (Ctrl+0)"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right" Text="{Binding Nota}" Foreground="{DynamicResource TestoTenue}" FontSize="12" VerticalAlignment="Center"
                           Visibility="{Binding HaNota, Converter={StaticResource BoolToVis}}"/>
            </DockPanel>
        </Border>

        <!-- La pagina: pagina intera di partenza, poi si ingrandisce e si scorre (anche trascinando con il mouse) -->
        <Grid Background="{DynamicResource SfondoVisualizzatore}">
            <ScrollViewer x:Name="Scorrimento" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SizeChanged="Scorrimento_SizeChanged" Focusable="False"
                          Visibility="{Binding HaImmagine, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Border x:Name="Pagina" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
                            BorderBrush="{DynamicResource Bordo}" BorderThickness="1" Margin="12"
                            MouseLeftButtonDown="Pagina_MouseLeftButtonDown" MouseMove="Pagina_MouseMove"
                            MouseLeftButtonUp="Pagina_MouseLeftButtonUp"
                            ToolTip="Doppio clic per ingrandire o tornare alla pagina intera">
                        <Image x:Name="Immagine" Source="{Binding Immagine, NotifyOnTargetUpdated=True}" TargetUpdated="Immagine_TargetUpdated" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>
            </ScrollViewer>

            <TextBlock Text="Caricamento…" Style="{StaticResource TestoCentrale}"
                       Visibility="{Binding CaricamentoVisibile, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Messaggio}" Style="{StaticResource TestoCentrale}"
                       Visibility="{Binding HaMessaggio, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </DockPanel>
</Window>
