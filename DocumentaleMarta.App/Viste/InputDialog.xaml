<Window x:Class="DocumentaleMarta.App.Viste.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CasellaTesto}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Messaggio" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="CasellaTesto" Padding="4" TextChanged="CasellaTesto_TextChanged"/>
        <TextBlock x:Name="Errore" Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="PulsanteOk" Content="OK" Width="90" Padding="0,4" IsDefault="True" Click="PulsanteOk_Click"/>
            <Button Content="Annulla" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
