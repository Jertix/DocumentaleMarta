<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        L'icona della ditta: un'incudine con un martello (la ditta fabbrica strutture metalliche).
        Disegnata su un quadrato di 64 x 64. Da qui si ricava anche il file .ico dell'applicazione
        (vedi tools/genera-icona.ps1): se si cambia il disegno va rigenerato.
    -->
    <DrawingImage x:Key="IconaAzienda">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Sfondo: quadrato arrotondato blu-ardesia -->
                <GeometryDrawing Brush="#2B3A4A">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Incudine: corno a sinistra, piano di battuta, vita stretta e base -->
                <GeometryDrawing Brush="#DDE4EB"
                                 Geometry="M8,30 L20,26 L51,26 L51,31 L43,32 L43,36 L47,40 L47,47 L17,47 L17,40 L21,36 L21,32 L14,32 Q8,32 8,30 Z"/>
                <!-- Riflesso sul piano di battuta -->
                <GeometryDrawing Brush="#FFFFFF" Geometry="M20,26 L51,26 L51,28.2 L19,28.2 Z"/>
                <!-- Ombra sotto la vita -->
                <GeometryDrawing Brush="#AEB9C4" Geometry="M21,36 L43,36 L47,40 L17,40 Z"/>
                <!-- Base -->
                <GeometryDrawing Brush="#9AA6B2" Geometry="M13,47 L51,47 L51,51 L13,51 Z"/>

                <!-- Martello sollevato: manico marrone e testa d'acciaio, inclinati verso l'alto a destra -->
                <DrawingGroup>
                    <DrawingGroup.Transform>
                        <TransformGroup>
                            <RotateTransform Angle="-38"/>
                            <TranslateTransform X="31" Y="19"/>
                        </TransformGroup>
                    </DrawingGroup.Transform>
                    <GeometryDrawing Brush="#B9793A" Geometry="M4,-2.2 L28,-2.2 Q30,-2.2 30,0 Q30,2.2 28,2.2 L4,2.2 Z"/>
                    <GeometryDrawing Brush="#EEF2F6" Geometry="M-5.5,-11 L5.5,-11 L5.5,11 L-5.5,11 Z"/>
                    <GeometryDrawing Brush="#A9B4C0" Geometry="M1.5,-11 L5.5,-11 L5.5,11 L1.5,11 Z"/>
                </DrawingGroup>

                <!-- Scintille nel punto in cui il martello batte -->
                <GeometryDrawing Brush="#FF9F1C" Geometry="M23.5,21 L25,23.4 L27.6,24 L25,24.6 L23.5,27 L22,24.6 L19.4,24 L22,23.4 Z"/>
                <GeometryDrawing Brush="#FFD23F" Geometry="M14,17 L15,18.8 L16.8,19.6 L15,20.4 L14,22.2 L13,20.4 L11.2,19.6 L13,18.8 Z"/>
                <GeometryDrawing Brush="#FF9F1C" Geometry="M17,9 L17.8,10.3 L19.2,10.9 L17.8,11.5 L17,12.8 L16.2,11.5 L14.8,10.9 L16.2,10.3 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
