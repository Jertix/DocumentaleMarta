<local:PersonaggioBase x:Class="DocumentaleMarta.App.Viste.PersonaggioGatto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocumentaleMarta.App.Viste"
        Width="40" Height="26" Focusable="False" IsHitTestVisible="False">
    <local:PersonaggioBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DocumentaleMarta.App;component/Viste/StiliPersonaggi.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:PersonaggioBase.Resources>

    <!-- Un gattino che cammina, di profilo e rivolto a destra: coda alta che ondeggia, due orecchie a punta, quattro zampe -->
    <Canvas Width="40" Height="26">
        <Canvas>
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="Rimbalzo"/>
            </Canvas.RenderTransform>

            <!-- Coda alta -->
            <Path Style="{StaticResource Tratto}" StrokeThickness="2.8" Canvas.Left="2.5" Canvas.Top="3"
                  Data="M5.5,11 C1,11 0,6 1.5,0.5">
                <Path.RenderTransform><RotateTransform x:Name="Coda" CenterX="5.5" CenterY="11"/></Path.RenderTransform>
            </Path>

            <!-- Zampe lontane (più chiare) -->
            <Path Style="{StaticResource Tratto}" StrokeThickness="2.6" Canvas.Left="9.2" Canvas.Top="17.2" Opacity="0.55"
                  Data="M1.3,1.3 L1.3,7">
                <Path.RenderTransform><RotateTransform x:Name="ZampaPosterioreLontana" CenterX="1.3" CenterY="1.3"/></Path.RenderTransform>
            </Path>
            <Path Style="{StaticResource Tratto}" StrokeThickness="2.6" Canvas.Left="21.2" Canvas.Top="17.2" Opacity="0.55"
                  Data="M1.3,1.3 L1.3,7">
                <Path.RenderTransform><RotateTransform x:Name="ZampaAnterioreLontana" CenterX="1.3" CenterY="1.3"/></Path.RenderTransform>
            </Path>

            <!-- Corpo, testa e orecchie -->
            <Path Data="M7,14.5 C7,10.5 10,9.5 14,9.5 L24,9.5 C27.5,9.5 29.5,11.5 29.5,14.5 C29.5,18.5 27,19.5 24,19.5 L13,19.5 C9.5,19.5 7,18.5 7,14.5 Z"/>
            <Ellipse Canvas.Left="25.5" Canvas.Top="4.5" Width="11.5" Height="10"/>
            <Path Data="M27.2,7.5 L27.8,1.2 L32,5.2 Z"/>
            <Path Data="M31,5 L35.2,1.2 L36,7.8 Z"/>

            <!-- Zampe vicine -->
            <Path Style="{StaticResource Tratto}" StrokeThickness="2.6" Canvas.Left="13.2" Canvas.Top="17.2"
                  Data="M1.3,1.3 L1.3,7">
                <Path.RenderTransform><RotateTransform x:Name="ZampaPosterioreVicina" CenterX="1.3" CenterY="1.3"/></Path.RenderTransform>
            </Path>
            <Path Style="{StaticResource Tratto}" StrokeThickness="2.6" Canvas.Left="25.2" Canvas.Top="17.2"
                  Data="M1.3,1.3 L1.3,7">
                <Path.RenderTransform><RotateTransform x:Name="ZampaAnterioreVicina" CenterX="1.3" CenterY="1.3"/></Path.RenderTransform>
            </Path>
        </Canvas>
    </Canvas>
</local:PersonaggioBase>
