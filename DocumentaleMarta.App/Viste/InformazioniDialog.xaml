<Window x:Class="DocumentaleMarta.App.Viste.InformazioniDialog"
        Background="{DynamicResource SfondoFinestra}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocumentaleMarta.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:InformazioniViewModel}"
        Title="Informazioni" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/DocumentaleMarta.App;component/Risorse/Documentale.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icone.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Etichetta" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TestoTenue}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,10,0,1"/>
            </Style>
            <Style x:Key="Valore" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24,20,24,18">
        <!-- Intestazione: logo, nome del programma e versione -->
        <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource IconaAzienda}" Width="72" Height="72"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Nome}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource TestoSecondario}"><Run Text="Versione "/><Run Text="{Binding Versione, Mode=OneWay}"/></TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- La ditta -->
        <TextBlock Text="Ditta" Style="{StaticResource Etichetta}" Margin="0,18,0,1"/>
        <TextBlock Text="{Binding Ditta}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Foreground="{DynamicResource TestoSecondario}" TextWrapping="Wrap">
            <Run Text="C.F. "/><Run Text="{Binding CodiceFiscale, Mode=OneWay}"/><Run Text="   -   P.IVA "/><Run Text="{Binding PartitaIva, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Text="{Binding Indirizzo}" Foreground="{DynamicResource TestoSecondario}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Descrizione}" Foreground="{DynamicResource TestoSecondario}" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- Dove sta tutto -->
        <TextBlock Text="Archivio" Style="{StaticResource Etichetta}"/>
        <TextBox Text="{Binding PercorsoArchivio, Mode=OneWay}" Style="{StaticResource Valore}"/>
        <TextBlock Text="{Binding Contenuto}" Foreground="{DynamicResource TestoSecondario}"/>

        <TextBlock Text="Database" Style="{StaticResource Etichetta}"/>
        <TextBox Text="{Binding PercorsoDatabase, Mode=OneWay}" Style="{StaticResource Valore}"/>

        <TextBlock Text="File delle impostazioni" Style="{StaticResource Etichetta}"/>
        <TextBox Text="{Binding PercorsoImpostazioni, Mode=OneWay}" Style="{StaticResource Valore}"/>

        <TextBlock Text="Riconoscimento del testo (OCR)" Style="{StaticResource Etichetta}"/>
        <TextBlock Text="{Binding StatoOcr}" TextWrapping="Wrap"/>

        <TextBlock Text="{Binding Ambiente}" Foreground="{DynamicResource TestoTenue}" FontSize="12" Margin="0,14,0,0"/>

        <Button Content="Chiudi" Width="90" Padding="0,4" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
