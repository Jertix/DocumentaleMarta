<Window x:Class="DocumentaleMarta.App.Viste.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocumentaleMarta.App.ViewModels"
        xmlns:viste="clr-namespace:DocumentaleMarta.App.Viste"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Documentale" Width="1180" Height="700" MinWidth="960" MinHeight="480"
        Icon="/DocumentaleMarta.App;component/Risorse/Documentale.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Colori.xaml"/>
                <ResourceDictionary Source="Icone.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <FontFamily x:Key="FontIcone">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding NomeAccessibile}"/>
                <EventSetter Event="Selected" Handler="NodoAlbero_Selected"/>
                <Style.Triggers>
                    <!-- Il nodo su cui si sta per rilasciare un documento o dei file -->
                    <Trigger Property="viste:BersaglioTrascinamento.Attivo" Value="True">
                        <Setter Property="Background" Value="#CFE6F8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Piccoli pulsanti quadrati con un'icona, per la barra in alto -->
            <Style x:Key="PulsanteBarra" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="FontFamily" Value="{StaticResource FontIcone}"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <!-- Il triangolo di avviso accanto ai nodi: arancione o rosso secondo la scadenza, assente se non c'è nulla da segnalare -->
            <Style x:Key="IconaAvvisoAlbero" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontIcone}"/>
                <Setter Property="Text" Value="&#xE7BA;"/>
                <Setter Property="Margin" Value="7,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Avviso}" Value="Arancione">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Foreground" Value="{StaticResource IconaArancione}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Avviso}" Value="Rosso">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Foreground" Value="{StaticResource IconaRossa}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- L'icona di un nodo; verde se è una cartella completata -->
            <Style x:Key="IconaNodoAlbero" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontIcone}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Margin" Value="0,0,7,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <!-- Da selezionata la cartella ha i colori della selezione: il verde sul blu non si leggerebbe -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Completato}" Value="True"/>
                            <Condition Binding="{Binding IsSelected}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{StaticResource IconaCompletata}"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Il nome di un nodo; grigio se è una cartella completata (a meno che sia selezionata: lì vale il colore della selezione) -->
            <Style x:Key="TestoNodoAlbero" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Completato}" Value="True"/>
                            <Condition Binding="{Binding IsSelected}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{StaticResource TestoCompletata}"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <HierarchicalDataTemplate DataType="{x:Type vm:NodoAlberoViewModel}" ItemsSource="{Binding Figli}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="{Binding Icona}" Style="{StaticResource IconaNodoAlbero}" ToolTip="{Binding DescrizioneStato}"/>
                    <TextBlock Text="{Binding Testo}" Style="{StaticResource TestoNodoAlbero}"/>
                    <TextBlock Style="{StaticResource IconaAvvisoAlbero}" ToolTip="{Binding DescrizioneAvviso}"/>
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Piè di pagina: dati della ditta, letti dal file delle impostazioni -->
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <!-- Backup in corso (vuoto quando non c'è) -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding TestoBackup}" Foreground="#1F5F99" FontSize="12"
                           Margin="16,0,0,0" FontWeight="SemiBold"/>
                <!-- Stato della lettura dei documenti in background (vuoto quando non c'è nulla da dire) -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding TestoIndicizzazione}" ToolTip="{Binding DettaglioIndicizzazione}"
                           Foreground="#555" FontSize="12" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                <!-- Il logo della ditta accanto ai suoi dati -->
                <Image DockPanel.Dock="Left" Source="{StaticResource IconaAzienda}" Width="20" Height="20" Margin="0,0,8,0"
                       ToolTip="{Binding DescrizioneAzienda}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TestoAzienda}" ToolTip="{Binding DescrizioneAzienda}"
                           Foreground="#555" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Barra degli strumenti -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Ricerca: cerca in nome file, titolo e descrizione della cartella, area e testo dei documenti -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding RicercaDisponibile, Converter={StaticResource BoolToVis}}">
                    <Grid Width="260">
                        <TextBox x:Name="CasellaRicerca" Text="{Binding TestoRicerca, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4,28,4" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Cerca nei documenti">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CercaCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding PulisciRicercaCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Cerca nei documenti…" Foreground="#999" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CasellaRicerca}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="&#x2715;" Command="{Binding PulisciRicercaCommand}" ToolTip="Svuota la ricerca"
                                Width="22" Height="22" Margin="0,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Visibility="{Binding TestoRicercaAttivo, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Button Content="Cerca" Command="{Binding CercaCommand}" Padding="14,4" Margin="6,0,0,0"/>
                    <ToggleButton Content="{Binding Filtri.TestoPulsante}" IsChecked="{Binding PannelloFiltriAperto}"
                                  Padding="12,4" Margin="6,0,0,0" ToolTip="Filtra per tipo di file, area, stato e scadenza"/>
                </StackPanel>

                <!-- Impostazioni e informazioni, all'estremo destro -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                    <ToggleButton Content="Anteprima" IsChecked="{Binding Anteprima.Visibile}" Padding="12,4" Margin="0,0,8,0"
                                  ToolTip="Mostra o nasconde l'anteprima del documento selezionato"
                                  Visibility="{Binding AnteprimaDisponibile, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="&#xE713;" Command="{Binding ApriImpostazioniCommand}" Style="{StaticResource PulsanteBarra}"
                            ToolTip="Impostazioni" AutomationProperties.Name="Impostazioni"
                            Visibility="{Binding ImpostazioniDisponibili, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="&#xE946;" Command="{Binding ApriInformazioniCommand}" Style="{StaticResource PulsanteBarra}"
                            ToolTip="Informazioni" AutomationProperties.Name="Informazioni" Margin="4,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Nuova area" Command="{Binding NuovaAreaCommand}" Padding="12,4"/>
                    <Button Content="Nuova cartella" Command="{Binding NuovaCartellaCommand}" Padding="12,4" Margin="8,0,0,0"/>
                    <Button Content="Backup" Command="{Binding EseguiBackupCommand}" Padding="12,4" Margin="20,0,0,0"
                            ToolTip="Salva una copia di tutto l'archivio (documenti e database) in un file ZIP"
                            Visibility="{Binding BackupDisponibile, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Ripristina…" Command="{Binding RipristinaDaBackupCommand}" Padding="12,4" Margin="8,0,0,0"
                            ToolTip="Ripristina l'archivio da un file di backup (ZIP): non tocca l'archivio attuale"
                            Visibility="{Binding BackupDisponibile, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Promemoria del backup: compare solo se è passato troppo tempo -->
        <Border DockPanel.Dock="Top" Padding="12,6" Background="#FFF4CE" BorderBrush="#E6D08A" BorderThickness="0,0,0,1"
                Visibility="{Binding PromemoriaBackupVisibile, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Più tardi" Command="{Binding RimandaPromemoriaBackupCommand}"
                        Padding="12,2" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Fai il backup ora" Command="{Binding EseguiBackupCommand}" Padding="12,2"/>
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcone}" Foreground="#9A6700" FontSize="15"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding TestoPromemoriaBackup}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Ricerca avanzata: i filtri si applicano subito, insieme alle parole scritte nel campo -->
        <Border DockPanel.Dock="Top" Padding="12,8,12,10" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"
                Visibility="{Binding PannelloFiltriAperto, Converter={StaticResource BoolToVis}}">
            <WrapPanel>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Tipo di file" Foreground="#666" FontSize="12" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" Height="24">
                        <CheckBox Content="PDF" IsChecked="{Binding Filtri.Pdf}" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                        <CheckBox Content="Word" IsChecked="{Binding Filtri.Word}" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                  ToolTip="Documenti di testo: Word, OpenOffice e LibreOffice (.odt), RTF"/>
                        <CheckBox Content="Excel" IsChecked="{Binding Filtri.Excel}" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                  ToolTip="Fogli di calcolo: Excel, OpenOffice e LibreOffice (.ods), CSV"/>
                        <CheckBox Content="Immagini" IsChecked="{Binding Filtri.Immagini}" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                        <CheckBox Content="Altro" IsChecked="{Binding Filtri.Altro}" VerticalContentAlignment="Center"
                                  ToolTip="Testo semplice, presentazioni (PowerPoint, Impress), disegni e tutti gli altri formati"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Area" Foreground="#666" FontSize="12" Margin="0,0,0,3"/>
                    <ComboBox Width="170" ItemsSource="{Binding Filtri.Aree}" SelectedItem="{Binding Filtri.Area}"
                              DisplayMemberPath="Nome"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Stato delle cartelle" Foreground="#666" FontSize="12" Margin="0,0,0,3"/>
                    <ComboBox Width="150" ItemsSource="{Binding Filtri.Stati}" SelectedItem="{Binding Filtri.Stato}"
                              DisplayMemberPath="Testo" ToolTip="{Binding SuggerimentoStatoRicerca}"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Scadenza dal … al" Foreground="#666" FontSize="12" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker Width="118" SelectedDate="{Binding Filtri.ScadenzaDal}"/>
                        <TextBlock Text="–" VerticalAlignment="Center" Margin="6,0"/>
                        <DatePicker Width="118" SelectedDate="{Binding Filtri.ScadenzaAl}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                    <CheckBox Content="Cerca anche dentro i documenti" IsChecked="{Binding Filtri.CercaNelContenuto}"
                              VerticalAlignment="Center" Margin="0,0,16,4"/>
                    <Button Content="Azzera filtri" Command="{Binding Filtri.AzzeraCommand}" Padding="12,3" Margin="0,0,0,2"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Albero -->
            <TreeView x:Name="Albero" Grid.Column="0" ItemsSource="{Binding Radici}" BorderThickness="0" Padding="4"
                      PreviewMouseRightButtonDown="Albero_PreviewMouseRightButtonDown"
                      AllowDrop="True" DragOver="Albero_DragOver" DragLeave="Albero_DragLeave" Drop="Albero_Drop">
                <TreeView.InputBindings>
                    <KeyBinding Key="F2" Command="{Binding RinominaCommand}"/>
                    <KeyBinding Key="Delete" Command="{Binding EliminaCommand}"/>
                    <KeyBinding Key="F5" Command="{Binding AggiornaCommand}"/>
                </TreeView.InputBindings>
                <TreeView.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Nuova area" Command="{Binding NuovaAreaCommand}"
                                  Visibility="{Binding RadiceSelezionata, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Nuova cartella" Command="{Binding NuovaCartellaCommand}"
                                  Visibility="{Binding AreaSelezionata, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Rinomina" InputGestureText="F2" Command="{Binding RinominaCommand}"
                                  Visibility="{Binding PuoModificare, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Elimina" InputGestureText="Canc" Command="{Binding EliminaCommand}"
                                  Visibility="{Binding PuoModificare, Converter={StaticResource BoolToVis}}"/>
                        <Separator Visibility="{Binding PuoModificare, Converter={StaticResource BoolToVis}}"/>
                        <!-- Archivio completati: le cartelle compaiono in fondo all'albero, i file non si spostano -->
                        <MenuItem Header="Archivia" Command="{Binding ArchiviaCommand}"
                                  ToolTip="Mette la cartella completata in «Archivio completati»: non sposta nessun file"
                                  Visibility="{Binding PuoArchiviare, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Ripristina nell'area" Command="{Binding RipristinaCommand}"
                                  ToolTip="Rimette la cartella nella sua area dell'albero"
                                  Visibility="{Binding PuoRipristinare, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Archivia le cartelle completate" Command="{Binding ArchiviaCompletateCommand}"
                                  ToolTip="Mette in «Archivio completati» tutte le cartelle completate: non sposta nessun file"
                                  Visibility="{Binding PuoArchiviareCompletate, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Apri in Esplora file" Command="{Binding ApriInEsploraCommand}"
                                  Visibility="{Binding HaPercorsoFisico, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Aggiorna" InputGestureText="F5" Command="{Binding AggiornaCommand}"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#E4E4E4" ShowsPreview="False"/>

            <!-- Pannello di destra: riepilogo per radice e aree, form per le cartelle -->
            <Grid Grid.Column="2">
                <!-- Radice, aree e "Scadenze": intestazione con il riepilogo e sotto la griglia -->
                <DockPanel Visibility="{Binding RiepilogoVisibile, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="28,22,28,14">
                        <Button DockPanel.Dock="Right" Content="Apri in Esplora file" Command="{Binding ApriInEsploraCommand}"
                                Visibility="{Binding HaPercorsoFisico, Converter={StaticResource BoolToVis}}"
                                VerticalAlignment="Top" Padding="12,4" Margin="16,4,0,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding TipoDettaglio}" Foreground="#777" FontSize="13"/>
                            <TextBlock Text="{Binding TitoloDettaglio}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding RiepilogoDettaglio}" Foreground="#444" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding PercorsoDettaglio}" Foreground="#777" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <viste:ElencoView DataContext="{Binding ElencoDocumenti}" Margin="28,0,28,20">
                        <viste:ElencoView.Style>
                            <Style TargetType="viste:ElencoView">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </viste:ElencoView.Style>
                    </viste:ElencoView>

                    <viste:ScadenzeView DataContext="{Binding ElencoScadenze}" Margin="28,0,28,20">
                        <viste:ScadenzeView.Style>
                            <Style TargetType="viste:ScadenzeView">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </viste:ScadenzeView.Style>
                    </viste:ScadenzeView>
                </DockPanel>

                <viste:CartellaView DataContext="{Binding FormCartella}">
                    <viste:CartellaView.Style>
                        <Style TargetType="viste:CartellaView">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </viste:CartellaView.Style>
                </viste:CartellaView>
            </Grid>

            <!-- Anteprima del documento selezionato: si vede solo se il pannello è aperto -->
            <viste:AnteprimaView Grid.Column="3" Width="300" DataContext="{Binding Anteprima}">
                <viste:AnteprimaView.Style>
                    <Style TargetType="viste:AnteprimaView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibile}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </viste:AnteprimaView.Style>
            </viste:AnteprimaView>
        </Grid>
    </DockPanel>
</Window>
