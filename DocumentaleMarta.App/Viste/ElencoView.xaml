<UserControl x:Class="DocumentaleMarta.App.Viste.ElencoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocumentaleMarta.App.ViewModels"
             xmlns:viste="clr-namespace:DocumentaleMarta.App.Viste"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ElencoDocumentiViewModel}"
             d:DesignWidth="780" d:DesignHeight="420">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Colori.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <FontFamily x:Key="FontIcone">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- Sfondo secondo l'urgenza della scadenza della cartella; testo rosso se il file non c'è più -->
            <Style x:Key="RigaDocumento" TargetType="DataGridRow">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Avviso}" Value="Arancione">
                        <Setter Property="Background" Value="{StaticResource SfondoArancione}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Avviso}" Value="Rosso">
                        <Setter Property="Background" Value="{StaticResource SfondoRosso}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FileMancante}" Value="True">
                        <Setter Property="Foreground" Value="#B42318"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CellaTesto" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- Pulsanti compatti: icona e, al passaggio del mouse, la descrizione -->
            <Style x:Key="PulsanteIcona" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="FontFamily" Value="{StaticResource FontIcone}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <DataGrid x:Name="Griglia" ItemsSource="{Binding Documenti}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E4E4E4" BorderBrush="#D0D0D0" Background="White"
                  SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" RowHeight="36"
                  SelectedItem="{Binding DocumentoSelezionato, Mode=TwoWay}"
                  RowStyle="{StaticResource RigaDocumento}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="30" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcone}" Foreground="#B42318"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       ToolTip="Il file non si trova più nell'archivio"
                                       Visibility="{Binding FileMancante, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nome file" Binding="{Binding NomeFile}" Width="*" MinWidth="120"
                                    ElementStyle="{StaticResource CellaTesto}"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="55"
                                    ElementStyle="{StaticResource CellaTesto}"/>
                <DataGridTextColumn Header="Cartella" Binding="{Binding TitoloCartella}" Width="0.8*" MinWidth="70"
                                    ElementStyle="{StaticResource CellaTesto}"/>
                <DataGridTextColumn x:Name="ColonnaArea" Header="Area" Binding="{Binding NomeArea}" Width="0.6*" MinWidth="60"
                                    ElementStyle="{StaticResource CellaTesto}"/>

                <!-- Solo nei risultati di una ricerca: dove e cosa è stato trovato, con le parole evidenziate -->
                <DataGridTemplateColumn x:Name="ColonnaTrovato" Header="Trovato" Width="2.6*" MinWidth="180" SortMemberPath="Trovato">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Due righe: l'estratto è lungo e la parola trovata non deve restare fuori vista -->
                            <TextBlock viste:TestoEvidenziato.Testo="{Binding Trovato}" ToolTip="{Binding Trovato}"
                                       VerticalAlignment="Center" Padding="4,0" FontSize="12"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="ColonnaScadenza" Header="Scadenza" Binding="{Binding Scadenza, StringFormat='dd/MM/yyyy'}" Width="85"
                                    ElementStyle="{StaticResource CellaTesto}"/>
                <DataGridTextColumn x:Name="ColonnaCaricato" Header="Caricato il" Binding="{Binding DataCaricamento, StringFormat='dd/MM/yyyy'}" Width="85"
                                    ElementStyle="{StaticResource CellaTesto}"/>
                <DataGridTemplateColumn Header="Azioni" Width="Auto" MinWidth="110" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&#xE8E5;" Command="{Binding ApriCommand}" Style="{StaticResource PulsanteIcona}"
                                        ToolTip="Apri documento" AutomationProperties.Name="Apri documento"/>
                                <Button Content="&#xE838;" Command="{Binding ApriNellaCartellaCommand}" Style="{StaticResource PulsanteIcona}"
                                        ToolTip="Apri nella cartella" AutomationProperties.Name="Apri nella cartella"/>
                                <Button Content="&#xE74D;" Command="{Binding EliminaCommand}" Style="{StaticResource PulsanteIcona}"
                                        ToolTip="Elimina" AutomationProperties.Name="Elimina"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Elenco vuoto -->
        <TextBlock Text="{Binding TestoVuoto}" Foreground="#888"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Documenti.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
