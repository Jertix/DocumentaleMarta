<local:PersonaggioBase x:Class="DocumentaleMarta.App.Viste.PersonaggioUccellino"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocumentaleMarta.App.Viste"
        Width="32" Height="24" Focusable="False" IsHitTestVisible="False">
    <local:PersonaggioBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DocumentaleMarta.App;component/Viste/StiliPersonaggi.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:PersonaggioBase.Resources>

    <!-- Un uccellino che vola, di profilo e rivolto a destra: corpo, testa col becco, coda e un'ala che batte -->
    <Canvas Width="32" Height="24">
        <Canvas>
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="Rimbalzo"/>
            </Canvas.RenderTransform>

            <!-- Coda, corpo, testa e becco -->
            <Path Data="M8,13 L0.5,9.2 L1.8,16.3 Z"/>
            <Ellipse Canvas.Left="6" Canvas.Top="9.5" Width="17.5" Height="10"/>
            <Ellipse Canvas.Left="19" Canvas.Top="5" Width="8.5" Height="8.5"/>
            <Path Data="M26.8,8.3 L31.5,9.8 L26.8,11.3 Z"/>

            <!-- Zampette raccolte sotto la pancia -->
            <Path Style="{StaticResource Tratto}" StrokeThickness="1.4" Data="M12.5,18.5 L10.8,21.8 M16.5,18.8 L15.2,22"/>

            <!-- L'ala: si ribalta rispetto alla spalla (da alzata ad abbassata) a ogni battito -->
            <Path Data="M10.5,13.5 C8,5.5 15,1 22,2.5 C19.5,7.5 17,11 15.5,13.5 Z">
                <Path.RenderTransform><ScaleTransform x:Name="Ala" CenterX="13" CenterY="13.5"/></Path.RenderTransform>
            </Path>
        </Canvas>
    </Canvas>
</local:PersonaggioBase>
