<Window x:Class="DocumentaleMarta.App.Viste.AreaDialog"
        Background="{DynamicResource SfondoFinestra}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocumentaleMarta.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AreaDialogViewModel}"
        Title="{Binding Titolo}" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Finestra_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="FontIcone">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Un riquadro della griglia: il simbolo al centro, un contorno colorato se è quello scelto -->
        <Style x:Key="RiquadroIcona" TargetType="ListBoxItem">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="ToolTip" Value="{Binding Descrizione}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Descrizione}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Riquadro" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Riquadro" Property="BorderBrush" Value="{DynamicResource Bordo}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Riquadro" Property="Background" Value="{DynamicResource SfondoAccentoLeggero}"/>
                                <Setter TargetName="Riquadro" Property="BorderBrush" Value="{DynamicResource BordoAccento}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TestoAccento}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- Il nome: solo per una nuova area -->
        <StackPanel Visibility="{Binding ChiedeNome, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Nome della nuova area (ad esempio Fatture o INPS):" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBox x:Name="CasellaNome" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Padding="4"
                     AutomationProperties.Name="Nome della nuova area"/>
            <TextBlock Text="{Binding ErroreNome}" Foreground="{DynamicResource TestoRosso}" TextWrapping="Wrap"
                       Margin="0,6,0,0" MinHeight="18"/>
        </StackPanel>

        <TextBlock Text="{Binding MessaggioIcona}" TextWrapping="Wrap" Margin="0,8,0,6"/>

        <ListBox x:Name="ElencoIcone" ItemsSource="{Binding Icone}" SelectedItem="{Binding IconaSelezionata}"
                 ItemContainerStyle="{StaticResource RiquadroIcona}"
                 BorderThickness="0" Background="Transparent" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Icone disponibili">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Glifo}" FontFamily="{StaticResource FontIcone}" FontSize="20"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{Binding DescrizioneIconaSelezionata}" Foreground="{DynamicResource TestoSecondario}" FontSize="12"
                   Margin="2,6,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="90" Padding="0,4" IsDefault="True" IsEnabled="{Binding PuoConfermare}" Click="PulsanteOk_Click"/>
            <Button Content="Annulla" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
