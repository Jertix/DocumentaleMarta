<local:PersonaggioBase x:Class="DocumentaleMarta.App.Viste.PersonaggioOperaio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocumentaleMarta.App.Viste"
        Width="28" Height="32" Focusable="False" IsHitTestVisible="False">
    <local:PersonaggioBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DocumentaleMarta.App;component/Viste/StiliPersonaggi.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:PersonaggioBase.Resources>

    <!-- Un operaio col casco, di profilo e rivolto a destra, con il martello in mano -->
    <Canvas Width="28" Height="32">
        <Canvas>
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="Rimbalzo"/>
            </Canvas.RenderTransform>

            <!-- Braccio e gamba lontani (più chiari) -->
            <Path Style="{StaticResource Tratto}" StrokeThickness="2.8" Canvas.Left="10" Canvas.Top="11.5" Opacity="0.55"
                  Data="M1.5,1.5 L1.5,10">
                <Path.RenderTransform><RotateTransform x:Name="BraccioLontano" CenterX="1.5" CenterY="1.5"/></Path.RenderTransform>
            </Path>
            <Path Style="{StaticResource Tratto}" StrokeThickness="3.4" Canvas.Left="9.8" Canvas.Top="19.8" Opacity="0.55"
                  Data="M1.7,1.7 L1.7,10.2">
                <Path.RenderTransform><RotateTransform x:Name="GambaLontana" CenterX="1.7" CenterY="1.7"/></Path.RenderTransform>
            </Path>

            <!-- Testa, casco (cupola con la tesa larga) e busto robusto -->
            <Ellipse Canvas.Left="8" Canvas.Top="6.2" Width="7" Height="7"/>
            <Path Data="M5.6,8 C5.6,3 8,0.4 11.5,0.4 C15,0.4 17.4,3 17.4,8 Z"/>
            <Path Data="M3.4,7.6 L19.6,7.6 L19.6,9.4 L3.4,9.4 Z"/>
            <Path Style="{StaticResource Tratto}" StrokeThickness="6" Data="M11.5,14 L11.5,20.5"/>

            <!-- Gamba vicina -->
            <Path Style="{StaticResource Tratto}" StrokeThickness="3.4" Canvas.Left="9.8" Canvas.Top="19.8"
                  Data="M1.7,1.7 L1.7,10.2">
                <Path.RenderTransform><RotateTransform x:Name="GambaVicina" CenterX="1.7" CenterY="1.7"/></Path.RenderTransform>
            </Path>

            <!-- Braccio vicino con il martello: manico e testa si muovono insieme al braccio -->
            <Canvas Canvas.Left="10" Canvas.Top="11.5">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="BraccioVicino" CenterX="1.5" CenterY="1.5"/>
                </Canvas.RenderTransform>
                <Path Style="{StaticResource Tratto}" StrokeThickness="2.8" Data="M1.5,1.5 L1.5,10"/>
                <Path Style="{StaticResource Tratto}" StrokeThickness="1.8" Data="M1.5,10 L8,3.5"/>
                <Path Data="M5.4,0.6 L11.6,5.4 L9.4,8.2 L3.2,3.4 Z"/>
            </Canvas>
        </Canvas>
    </Canvas>
</local:PersonaggioBase>
